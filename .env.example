# ─────────────────────────────────────────────────────────────────────────────
# Airlink AI — environment template
#
# Copy to `.env` (or set these in the hosting panel) and fill in real values.
# NEVER commit a filled-in copy. See docs/DEPLOYMENT.md for the full checklist.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://user:password@host:3306/airlink_db"
# Off by default in production; query logs can contain customer data.
# PRISMA_LOG_QUERIES=true

# ── App ─────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
NODE_ENV=development

# ── Secrets (all required in production; no fallbacks exist there) ───────────
# Long random strings. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET="replace-with-a-long-random-string"
# Signs the public form timing token.
FORM_TOKEN_SECRET="replace-with-another-long-random-string"
# Salt for hashed IP / user-agent abuse signals. Changing it invalidates old hashes.
IP_HASH_SALT="replace-with-another-long-random-string"
# Bearer token for the scheduled retention job (POST /api/cron/retention).
CRON_SECRET="replace-with-another-long-random-string"

# ── SMTP (authenticated) ────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
# Only needed when SMTP_HOST serves a certificate for the provider's own name
# (common on GoDaddy/cPanel). Set this to the name in the certificate, e.g.
# SMTP_TLS_SERVERNAME=prod.sin2.secureserver.net — keeps TLS verification on.
SMTP_TLS_SERVERNAME=
# New-lead alert recipients (comma separated). Falls back to MAIL_TO.
LEAD_NOTIFY_EMAILS=

# ── AI assistant (Groq or OpenRouter — both use the OpenAI-compatible API) ──
# Groq (recommended): fast + free tier
#   Create a key at https://console.groq.com/keys
#   Use `GROQ_API_KEY` instead of `AI_API_KEY` if you prefer.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b
# Stronger reasoning:  AI_MODEL=openai/gpt-oss-120b
# Multilingual/Tamil:  AI_MODEL=qwen/qwen3.8-27b
#
# OpenRouter alternative:
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_MODEL=openai/gpt-4o-mini
# Daily cap on assistant chat calls (protects the free tier; persisted in AiUsage).
AI_DAILY_LIMIT=150

# ── AI lead intelligence (admin panel) ──────────────────────────────────────
# Rules-based scoring always runs for free. The LLM only adds a summary/next
# action when the daily quota allows it, so the feature never breaks on 429.
AI_LEAD_SCORING_ENABLED=true
# Free-model fallbacks tried in order when the primary model is rate-limited
AI_MODEL_FALLBACKS=openai/gpt-oss-120b,qwen/qwen3.8-27b
# Hard daily cap on AI calls for lead enrichment (protects the free tier)
AI_SCORE_DAILY_LIMIT=150
# Skip model calls for obvious junk leads below this heuristic score
AI_ENRICH_MIN_SCORE=40
# Observation mode (default ON): the LLM advises, it never changes lead status
# or rejects a lead. Only deterministic abuse triggers an automatic rejection.
AI_OBSERVATION_MODE=true

# ── Lead validation limits ──────────────────────────────────────────────────
# Characters (after trimming) allowed in a name. Flags, not rejections, apply
# to suspicious patterns.
LEAD_NAME_MIN=2
LEAD_NAME_MAX=80

# ── Anti-abuse rate limits ──────────────────────────────────────────────────
# Submissions allowed per hashed IP per hour.
LEAD_RATE_LIMIT_PER_HOUR=5
# Submissions allowed per phone number per day.
LEAD_PHONE_LIMIT_PER_DAY=3

# ── Data retention ──────────────────────────────────────────────────────────
# Days after which hashed IP / user-agent abuse signals are removed from a lead.
LEAD_PII_RETENTION_DAYS=90
# Days after which security and rate-limit logs are deleted.
SECURITY_EVENT_RETENTION_DAYS=180
