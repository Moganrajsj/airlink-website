generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model BackgroundAsset {
  id            String   @id @default(cuid())
  sectionName   String
  imageUrl      String?
  animationType String
  speed         Float    @default(1)
  opacity       Float    @default(0.2)
  status        Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

model Banner {
  id             String   @id @default(cuid())
  title          String
  subtitle       String?
  offerHighlight String?
  imageUrl       String?
  ctaText        String?
  ctaLink        String?
  bannerType     String
  status         Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model Plan {
  id         String   @id @default(cuid())
  title      String
  speed      Int
  price      Float
  features   String   @db.Text
  tag        String?
  isBusiness Boolean  @default(false)
  status     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Coverage {
  id         String   @id @default(cuid())
  cityName   String
  status     String
  /** Comma-separated PIN codes served by this area (optional). */
  pincodes   String?
  leadsCount Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  person    String?
  city      String   @default("Tamil Nadu")
  role      String?
  content   String
  rating    Int      @default(5)
  tag       String?
  metric    String?
  color     String   @default("#FBBF24")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Blog {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String
  content   String
  image     String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Lead {
  id         String   @id @default(cuid())
  name       String
  email      String?
  phone      String
  mobile     String   @default("")
  company    String?
  city       String
  pincode    String?
  interest   String?
  source     String   @default("contact_form")
  status     String   @default("new")
  assignedTo String?
  notes      String?
  planId     String?
  message    String?
  createdAt  DateTime @default(now())

  // Validation & anti-abuse (additive, nullable except statuses)
  rawName            String?
  rawPhone           String?
  nameNormalized     String?
  phoneNormalized    String?
  validationStatus   String   @default("valid")
  validationFlags    String?  @db.Text
  verificationStatus String   @default("unverified")
  botRisk            Int      @default(0)
  botSignals         String?  @db.Text
  campaign           String?
  ipHash             String?
  userAgentHash      String?
  duplicateOfId      String?

  // AI lead intelligence (all nullable / additive)
  aiScore           Int?
  aiTier            String?
  aiSummary         String?   @db.Text
  aiIntent          String?
  aiRecommendedPlan String?
  aiNextAction      String?
  aiTags            String?
  aiReasons         String?   @db.Text
  aiStatus          String    @default("pending")
  aiScoredAt        DateTime?
  aiModel           String?

  // Lead quality vs abuse risk are deliberately separate scores.
  qualityScore   Int?
  spamRisk       Int?
  classification String?
  confidence     String?
  reviewOutcome  String?
  followUpOwner  String?
  lastContactAt  DateTime?
  reviewedBy     String?
  reviewedAt     DateTime?

  events LeadEvent[]

  @@index([aiScore])
  @@index([aiStatus])
  @@index([createdAt])
  @@index([phoneNormalized])
  @@index([validationStatus])
  @@index([classification])
  @@index([duplicateOfId])
}

model AiUsage {
  id         String   @id @default(cuid())
  day        DateTime @unique @db.Date
  requests   Int      @default(0)
  failures   Int      @default(0)
  tokensIn   Int      @default(0)
  tokensOut  Int      @default(0)
  updatedAt  DateTime @updatedAt
}

/// Immutable audit trail for a lead: creation, validation, scoring, review,
/// status changes and duplicate links. Never overwritten.
model LeadEvent {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  actor     String?
  payload   String?  @db.Text
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([type, createdAt])
}

/// Durable rate limiting (in-memory counters reset on every deploy/restart).
model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}

/// Security-relevant events (auth failures, rate-limit blocks, honeypot hits).
/// Contains only hashed IPs — never raw addresses or customer details.
model SecurityEvent {
  id        String   @id @default(cuid())
  kind      String
  ipHash    String?
  detail    String?  @db.Text
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

/// Admin-editable approved knowledge for the public assistant.
model KnowledgeEntry {
  id        String   @id @default(cuid())
  category  String
  question  String
  answer    String   @db.Text
  keywords  String?  @db.Text
  priority  Int      @default(0)
  isActive  Boolean  @default(true)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String
  password         String
  role             String    @default("customer")
  plan             String?
  isPaid           Boolean   @default(false)
  billingDate      DateTime?
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
}

model SocialLink {
  id        String   @id @default(cuid())
  platform  String
  url       String
  icon      String?
  status    Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Admin {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}
